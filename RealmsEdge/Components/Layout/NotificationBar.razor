@using RealmsEdge.Shared.Models.Session
@using RealmsEdge.Shared.Services
@inject GameStateManager GameManager
@implements IDisposable

@if (_notifications.Any())
{
    <div class="notification-stack">
        @{
            List<GameNotification> snapshot;
            lock (_lock) { snapshot = _notifications.ToList(); }
        }
        @foreach (var note in snapshot)
        {
            <div class="notification-toast"
                 style="border-left-color:@note.TypeColour">
                <span>@note.TypeIcon</span>
                <span>@note.Message</span>
            </div>
        }
    </div>
}

@code {
    private readonly List<GameNotification> _notifications = new();
    private readonly object _lock = new();
    private System.Timers.Timer? _cleanupTimer;

    protected override void OnInitialized()
    {
        GameManager.OnNotification += HandleNotification;

        _cleanupTimer = new System.Timers.Timer(1000);
        _cleanupTimer.Elapsed += OnTimerElapsed;
        _cleanupTimer.AutoReset = true;
        _cleanupTimer.Start();
    }

    private void HandleNotification(GameNotification note)
    {
        lock (_lock)
        {
            _notifications.Add(note);
        }
        InvokeAsync(StateHasChanged);
    }

    private void OnTimerElapsed(object? sender, System.Timers.ElapsedEventArgs e)
    {
        var cutoff = DateTime.UtcNow.AddMilliseconds(-3000);
        bool changed;

        lock (_lock)
        {
            var before = _notifications.Count;
            _notifications.RemoveAll(n => n.CreatedAt < cutoff);
            changed = _notifications.Count != before;
        }

        if (changed)
            InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        GameManager.OnNotification -= HandleNotification;
        _cleanupTimer?.Stop();
        _cleanupTimer?.Dispose();
    }
}