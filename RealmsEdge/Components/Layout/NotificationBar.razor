@using RealmsEdge.Shared.Models.Session
@using RealmsEdge.Shared.Services
@inject GameStateManager GameManager
@implements IDisposable

@if (_notifications.Any())
{
    <div class="notification-stack">
        @foreach (var note in _notifications)
        {
            <div class="notification-toast"
                 style="border-left-color:@note.TypeColour">
                <span>@note.TypeIcon</span>
                <span>@note.Message</span>
            </div>
        }
    </div>
}

@code {
    private List<GameNotification> _notifications = new();
    private System.Timers.Timer? _cleanupTimer;

    protected override void OnInitialized()
    {
        GameManager.OnNotification += HandleNotification;

        _cleanupTimer = new System.Timers.Timer(1000);
        _cleanupTimer.Elapsed += (_, _) => CleanExpired();
        _cleanupTimer.Start();
    }

    private void HandleNotification(GameNotification note)
    {
        _notifications.Add(note);
        InvokeAsync(StateHasChanged);
    }

    private void CleanExpired()
    {
        var cutoff = DateTime.UtcNow.AddMilliseconds(
            -3000);
        var before = _notifications.Count;
        _notifications.RemoveAll(n =>
            n.CreatedAt < cutoff);
        if (_notifications.Count != before)
            InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        GameManager.OnNotification -= HandleNotification;
        _cleanupTimer?.Dispose();
    }
}