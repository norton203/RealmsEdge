@inherits LayoutComponentBase
@using RealmsEdge.Shared.Enums
@using RealmsEdge.Shared.Services
@inject GameStateManager GameManager
@inject NavigationManager NavManager
@implements IDisposable

<MudThemeProvider Theme="_realmTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="realm-shell">
    <div class="realm-background @GetBackgroundClass()">
        <div class="realm-background-overlay"></div>
    </div>

    @if (ShowHeader)
    {
        <header class="realm-header">
            <GameHeader />
        </header>
    }

    <main class="realm-main @(IsFullscreen ? "main-fullscreen" : "main-padded")">
        @Body
    </main>

    @if (ShowFooter)
    {
        <footer class="realm-footer">
            <GameFooter />
        </footer>
    }

    <div class="realm-notifications">
        <NotificationBar />
    </div>

    @if (_isPaused)
    {
        <div class="realm-pause-overlay">
            <div class="realm-pause-panel paper">
                <h2 class="text-center">⏸️ Paused</h2>
                <div class="realm-pause-actions">
                    <button class="btn-realm"
                            @onclick="Resume">
                        ▶ Resume
                    </button>
                    <button class="btn-ghost"
                            @onclick="GoToMainMenu">
                        🏰 Main Menu
                    </button>
                </div>
            </div>
        </div>
    }

    @if (_isLoading)
    {
        <div class="realm-loading-overlay">
            <div class="realm-loading-spinner">
                <span class="spinner-emblem">⚔️</span>
                <span class="spinner-text">
                    @_loadingMessage
                </span>
            </div>
        </div>
    }
</div>

@code {
    private bool _isPaused;
    private bool _isLoading;
    private string _loadingMessage = "Please wait...";

    private bool ShowHeader =>
        GameManager.HasSession &&
        GameManager.CurrentState != GameState.MainMenu &&
        GameManager.CurrentState != GameState.CharacterCreate &&
        GameManager.CurrentState != GameState.CharacterSelect;

    private bool ShowFooter =>
        GameManager.HasSession &&
        GameManager.CurrentState != GameState.MainMenu &&
        GameManager.CurrentState != GameState.CharacterCreate &&
        GameManager.CurrentState != GameState.CharacterSelect;

    private bool IsFullscreen =>
        GameManager.CurrentState == GameState.CombatPlayerTurn ||
        GameManager.CurrentState == GameState.CombatEnemyTurn ||
        GameManager.CurrentState == GameState.MainMenu;

    private string GetBackgroundClass() =>
        GameManager.CurrentState switch
        {
            GameState.MainMenu or
            GameState.CharacterCreate or
            GameState.CharacterSelect => "bg-menu",
            GameState.CombatPlayerTurn or
            GameState.CombatEnemyTurn or
            GameState.CombatStart => "bg-combat",
            GameState.Exploring when
                GameManager.HasSession &&
                GameManager.Session.IsInDungeon => "bg-dungeon",
            GameState.Exploring => "bg-world",
            _ => "bg-menu"
        };

    protected override void OnInitialized()
    {
        GameManager.OnStateChanged += HandleStateChanged;
        if (!GameManager.HasSession)
            GameManager.StartNewSession();
    }

    private void HandleStateChanged()
    {
        _isPaused  = GameManager.CurrentState == GameState.Paused;
        _isLoading = GameManager.CurrentState == GameState.Loading ||
                     GameManager.CurrentState == GameState.Travelling;

        _loadingMessage = GameManager.CurrentState switch
        {
            GameState.Travelling => "Travelling...",
            GameState.Loading    => "Loading...",
            GameState.Saving     => "Saving...",
            _                    => "Please wait..."
        };

        // Navigate to correct page based on state
        var target = GameManager.CurrentState switch
        {
            GameState.MainMenu        => "/",
            GameState.CharacterCreate => "/create",
            GameState.CharacterSelect => "/select",
            GameState.Exploring       => "/world",
            GameState.CombatPlayerTurn or
            GameState.CombatStart      => "/combat",
            GameState.QuestJournal     => "/quests",
            _                          => null
        };

        if (target != null && !NavManager.Uri.EndsWith(target))
        {
             NavManager.NavigateTo(target);
            return; 
        }
       

        InvokeAsync(StateHasChanged);
    }

    private void Resume() => GameManager.Resume();

    private void GoToMainMenu()
    {
        GameManager.TransitionTo(GameState.MainMenu);
        NavManager.NavigateTo("/");
    }

    public void Dispose()
    {
        GameManager.OnStateChanged -= HandleStateChanged;
    }
    private MudTheme _realmTheme = new MudTheme
{
    PaletteLight = new PaletteLight
    {
        Primary         = "#F0C040",
        PrimaryDarken   = "#8B6914",
        Secondary       = "#C0430A",
        Background      = "#0a0a0f",
        Surface         = "#1a1a2e",
        DrawerBackground = "#111118",
        AppbarBackground = "#111118",
        TextPrimary     = "#D4C9A8",
        TextSecondary   = "#8B7355",
        ActionDefault   = "#F0C040",
        Divider         = "#2e2e50",
        OverlayDark     = "rgba(0,0,0,0.75)"
    },
    PaletteDark = new PaletteDark
    {
        Primary         = "#F0C040",
        PrimaryDarken   = "#8B6914",
        Secondary       = "#C0430A",
        Background      = "#0a0a0f",
        Surface         = "#1a1a2e",
        DrawerBackground = "#111118",
        AppbarBackground = "#111118",
        TextPrimary     = "#D4C9A8",
        TextSecondary   = "#8B7355",
        ActionDefault   = "#F0C040",
        Divider         = "#2e2e50",
    },
    Typography = new Typography
    {
        Default = new DefaultTypography
        {
            FontFamily = new[]
                { "IM Fell English", "Georgia", "serif" }
        },
        H1 = new H1Typography
        {
            FontFamily = new[]
                { "Cinzel", "MedievalSharp", "serif" },
            FontSize   = "2rem"
        },
        H2 = new H2Typography
        {
            FontFamily = new[]
                { "Cinzel", "MedievalSharp", "serif" },
            FontSize   = "1.5rem"
        },
        H3 = new H3Typography
        {
            FontFamily = new[]
                { "Cinzel", "MedievalSharp", "serif" },
            FontSize   = "1.25rem"
        },
        Button = new ButtonTypography
        {
            FontFamily    = new[]
                { "Cinzel", "MedievalSharp", "serif" },
            FontSize      = "0.85rem",
            LetterSpacing = "0.08em"
        }
    }
   
};
}